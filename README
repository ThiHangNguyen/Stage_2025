transformer - il faut changer nom d'outil:
python3 src/main.py --tool grobid --id test/1013496ar
sur un répertoire : ( --batch ou --xml_2cols)
python3 src/main.py --tool grobid --batch

1.---------------transformation----------------------
python3 src/main.py --tool erudit  --id ae49/1039880ar // remplace grobid
python3 src/main.py --tool tatr --journals cqd27 ae49 haf18 2cols // transformer // grobid

2.---------------évaluation sur un journal---------------

python3 src/main.py --evaluation --journals cqd27 ae49 haf18 2cols --tool grobid 
python3 src/main.py --evaluation --journals cqd27 ae49 haf18 2cols --tool tatr
3.---------------visualisation--------------

Calculer des moyens:
python3 src/evaluation/compute_means.py --tool grobid --dirs ae49 cqd27 haf18 2cols
python3 src/evaluation/compute_means.py --tool tatr --dirs ae49 cqd27 haf18 2cols

structured field
python3 src/evaluation/plot.py --dir 2cols --type structured --method levenshtein --tool grobid
python3 src/evaluation/plot.py --type structured --method soft --metric recall --tool nougat

Simple field
python3 src/evaluation/plot.py --dir 2cols --type simple --tool grobid
python3 src/evaluation/plot.py --type simple --method levenshtein --tool grobid


---tester
python3 src/evaluation/visualisation.py --field title --method strict --tool grobid --dir ae49 --compare



sh pour grobid

"""
#!/bin/bash
INPUT_DIR="/Tmp/nguyth/project/Stage_2025/data/pdfs" 
OUTPUT_DIR="/Tmp/nguyth/project/Stage_2025/data/raw/xml_grobid/" 
mkdir -p "$OUTPUT_DIR"

for f in "$INPUT_DIR"/*.pdf; do 
	b=$(basename "$f" .pdf) 
	echo "Processing $f..." 
	curl -s -X POST http://localhost:8070/api/processFulltextDocument -F input=@"$f" -F consolidateHeader=1 -F consolidateCitations=1 -F consolidateFunding=1 -F includeRawAffiliations=1 -F includeRawCitations=1 -F includeRawCopyright=1 -F segmentSentences=1 -F generateIDs=1 -F teiCoordinates=persName -F teiCoordinates=figure -F teiCoordinates=ref -F teiCoordinates=biblStruct -F teiCoordinates=formula -F teiCoordinates=head -F teiCoordinates=label -F teiCoordinates=figureDesc -F teiCoordinates=table -F teiCoordinates=tr -F teiCoordinates=s -o "$OUTPUT_DIR/$b.xml" 
done 
"""