        </pagination></infoarticle><revue id="ae49" lang="fr"><titrerev>L'Actualité économique</titrerev><titrerevabr>ae</titrerevabr><idissn>0001-771X</idissn><idissnnum>1710-3991</idissnnum><directeur sexe="masculin"><nompers><prenom>Bruce</prenom><nomfamille>Shearer</nomfamille></nompers></directeur></revue><numero id="ae03128"><volume>92</volume><nonumero>4</nonumero><pub><periode>Décembre</periode><annee>2016</annee></pub><pubnum><date typedate="publication">2017-07-12</date></pubnum></numero><editeur><nomorg>HEC Montréal</nomorg></editeur><prod><nomorg>HEC Montréal</nomorg></prod><prodnum><nomorg>Érudit</nomorg></prodnum><diffnum><nomorg>Érudit</nomorg></diffnum><schema nom="Erudit Article" version="3.0.0" lang="fr"/><droitsauteur>Tous droits réservés © <nomorg>HEC Montréal</nomorg>, 2017</droitsauteur></admin><liminaire><grtitre>
